# --- App ---
NODE_ENV=development
PORT=3000
# URL publique (sert à fabriquer les liens de partage). Local : http://localhost:3000
BASE_URL=http://localhost:3000
# Domaine (utilisé par compose.prod.yaml pour la règle Traefik)
APP_DOMAIN=flowergift.arthurjaffro.fr
DATA_DIR=/data

# --- Admin (accès unique) ---
ADMIN_EMAIL=toi@example.com
# Hash argon2id du mot de passe : voir docs/DEPLOY.md ("Générer le hash")
# ⚠ dans un .env lu par Docker Compose, doubler chaque $ du hash ($$) ou le mettre entre quotes simples
ADMIN_PASSWORD_HASH=
# Secret de signature des cookies : openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=72

# --- Cadeaux ---
GIFT_TTL_DAYS=30            # 0 = n'expire jamais
GIFT_BOX_TAPS=5             # nombre de taps pour ouvrir la boîte

# --- SMTP Gmail (mot de passe d'APPLICATION, pas le mot de passe du compte) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ton.compte@gmail.com
# Vide = l'application tourne, mais l'envoi répond « SMTP non configuré »
SMTP_PASS=
SMTP_FROM_NAME=Arthur
# Doit être SMTP_USER ou un alias "Envoyer en tant que" validé dans Gmail
SMTP_FROM_EMAIL=ton.compte@gmail.com
